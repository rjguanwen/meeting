# 复制为 .env 后可覆盖默认配置
PORT=8002
DATABASE_URL=sqlite:///./meeting.db
SECRET_KEY=please-change-me-to-a-random-secret
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123
INIT_ADMIN_NAME=系统管理员

# === 企业微信微盘自动上传（可选，默认关闭） ===
# 会议归档时自动把最新会议纪要上传到微盘指定文件夹。
# 开关：是否启用自动上传
WECOM_AUTO_UPLOAD=false
# 私有化 API 基地址（不含 /cgi-bin），例如 https://weixin.xxxx.com.cn:8445
WECOM_API_BASE=
# 接口前缀，默认 /cgi-bin（私有化版以开发文档为准）
WECOM_API_PREFIX=/cgi-bin
# 企业 ID（管理后台-我的企业-企业信息）
WECOM_CORP_ID=
# 自建应用 ID（应用管理-自建，需配置微盘可调用权限）
WECOM_AGENT_ID=
# 自建应用密钥
WECOM_CORP_SECRET=
# 目标共享空间 ID
WECOM_SPACE_ID=
# 目标文件夹 fileid；留空表示上传到空间根目录
WECOM_FOLDER_ID=
# 归档时若尚未生成纪要，是否自动生成后上传（true/false）
WECOM_GENERATE_MISSING=true
# 上传文件名模板，支持 {title}/{date}/{id} 占位
WECOM_FILE_NAME_TEMPLATE=会议纪要-{title}-{date}.md
# 私有化环境自签证书时跳过校验（true/false）
WECOM_TLS_INSECURE=false
# 请求超时（秒）
WECOM_TIMEOUT_SECONDS=30
